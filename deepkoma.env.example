# ========================================================
# DeepKoma / AI Manga Translator - Environment Configuration
# Copy this file to `deepkoma.env` and fill in your real credentials.
# ========================================================

# LLM & Translation Service
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Supabase Auth
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# RunPod Serverless GPU Endpoints
RUNPOD_API_KEY=your_runpod_api_key_here
RUNPOD_TRANSLATE_ENDPOINT_ID=your_translate_endpoint_id_here
RUNPOD_REDRAW_ENDPOINT_ID=your_redraw_endpoint_id_here

# App URL
BACKEND_BASE_URL=https://deepkoma.pro

# Cloudflare R2 Object Storage
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY=your_r2_access_key_id
R2_SECRET_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=manga-temp-storage
R2_ENDPOINT_URL=https://your_account_id.r2.cloudflarestorage.com
R2_PUBLIC_DOMAIN=https://your_public_domain.r2.dev

# PayOS Payment Gateway
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key

# Developer Flags
DISABLE_LOCAL_NSFW=True
UFO_DEV_BYPASS=false
