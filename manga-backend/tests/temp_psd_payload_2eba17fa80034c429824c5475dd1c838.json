8, "w": 29, "h": 34, "text": "...", "japanese": "．．．", "fontSize": 18, "fontColor": "#ffffff", "fontFamily": "'Comic Neue', cursive", "rotation": 0, "sfxClass": "", "rawBox": {"x1": 1038, "x2": 1067, "y1": 798, "y2": 832}, "boxX": 1038, "boxY": 798, "boxW": 29, "boxH": 34, "textAlign": "center", "outlineWidth": 5, "outlineColor": "#030303", "hasShadow": false}, {"id": "1780782294493zadm2w0", "x": 371, "y": 784, "w": 144, "h": 42, "text": "CD-Findows", "japanese": "ＣＤ－Ｆｉｎｄｏｗｓ", "fontSize": 18, "fontColor": "#ffffff", "fontFamily": "'Comic Neue', cursive", "rotation": 0, "sfxClass": "", "rawBox": {"x1": 371, "x2": 515, "y1": 784, "y2": 826}, "boxX": 371, "boxY": 784, "boxW": 144, "boxH": 42, "textAlign": "center", "outlineWidth": 5, "outlineColor": "#030303", "hasShadow": false}, {"id": "1780782294493tmcw751", "x": 149, "y": 756, "w": 225, "h": 212, "text": "Hế...?", "japanese": "へー．．．", "fontSize": 18, "fontColor": "#ffffff", "fontFamily": "'Comic Neue', cursive", "rotation": 0, "sfxClass": "", "rawBox": {"x1": 149, "x2": 374, "y1": 756, "y2": 968}, "boxX": 149, "boxY": 756, "boxW": 225, "boxH": 212, "textAlign": "center", "outlineWidth": 5, "outlineColor": "#030303", "hasShadow": false}, {"id": "1780782294493thfj3uy", "x": 13, "y": 732, "w": 83, "h": 184, "text": "Và D của mảng sản xuất thực tế: thứ hạng này chắc chắn có nghĩa là——", "japanese": "そして実制作のＤ：この順位は絶対つまり――", "fontSize": 17, "fontColor": "#ffffff", "fontFamily": "'Comic Neue', cursive", "rotation": 0, "sfxClass": "", "rawBox": {"x1": 13, "x2": 96, "y1": 732, "y2": 916}, "boxX": 13, "boxY": 732, "boxW": 83, "boxH": 184, "textAlign": "center", "outlineWidth": 5, "outlineColor": "#030303", "hasShadow": false}, {"id": "1780782294493ysxitr4", "x": 403, "y": 731, "w": 229, "h": 203, "text": "AD - người giám sát chất lượng sản xuất CD, chịu trách nhiệm toàn bộ mảng sáng tạo", "japanese": "クリエイティブ部門の全幕任をもつＣＤ制作のクオリティーを監像するＡＤ－", "fontSize": 18, "fontColor": "#ffffff", "fontFamily": "'Comic Neue', cursive", "rotation": 0, "sfxClass": "", "rawBox": {"x1": 403, "x2": 632, "y1": 731, "y2": 934}, "boxX": 403, "boxY": 731, "boxW": 229, "boxH": 203, "textAlign": "center", "outlineWidth": 5, "outlineColor": "#030303", "hasShadow": false}, {"id": "1780782294493sey4pgk", "x": 163, "y": 650, "w": 115, "h": 104, "text": "với nhân sự sáng tạo", "japanese": "クリエイティブ人と", "fontSize": 18, "fontColor": "#ffffff", "fontFamily": "'Comic Neue', cursive", "rotation": 0, "sfxClass": "", "rawBox": {"x1": 163, "x2": 278, "y1": 650, "y2": 754}, "boxX": 163, "boxY": 650, "boxW": 115, "boxH": 104, "textAlign": "center", "outlineWidth": 5, "outlineColor": "#030303", "hasShadow": false}, {"id": "17807822944932d5gtj2", "x": 363, "y": 639, "w": 114, "h": 49, "text": "· Khuyến mãi bán hàng", "japanese": "・セールスプロモーション", "fontSize": 18, "fontColor": "#ffffff", "fontFamily": "'Comic Neue', cursive", "rotation": 0, "sfxClass": "", "rawBox": {"x1": 363, "x2": 477, "y1": 639, "y2": 688}, "boxX": 363, "boxY": 639, "boxW": 114, "boxH": 49, "textAlign": "center", "outlineWidth": 5, "outlineColor": "#030303", "hasShadow": false}, {"id": "17807822944932jcmwwp", "x": 988, "y": 637, "w": 65, "h": 122, "text": "!?", "japanese": "！？", "fontSize": 18, "fontColor": "#ffffff", "fontFamily": "'Comic Neue', cursive", "rotation": 0, "sfxClass": "", "rawBox": {"x1": 988, "x2": 1053, "y1": 637, "y2": 759}, "boxX": 988, "boxY": 637, "boxW": 65, "boxH": 122, "textAlign": "center", "outlineWidth": 5, "outlineColor": "#030303", "hasShadow": false}, {"id": "17807822944932cmn54n", "x": 761, "y": 584, "w": 165, "h": 114, "text": "Mày đang làm gì đấy, liên lạc ngay cho tao!", "japanese": "お前何してんの連絡しろ今すぐ", "fontSize": 18, "fontColor": "#ffffff", "fontFamily": "'Comic Neue', cursive", "rotation": 0, "sfxClass": "", "rawBox": {"x1": 761, "x2": 926, "y1": 584, "y2": 698}, "boxX": 761, "boxY": 584, "boxW": 165, "boxH": 114, "textAlign": "center", "outlineWidth": 5, "outlineColor": "#030303", "hasShadow": false}, {"id": "1780782294493uv36ab3", "x": 671, "y": 535, "w": 46, "h": 246, "text": "Ư ư ư ư ư ư!", "japanese": "いいぁあああぁ", "fontSize": 18, "fontColor": "#ffffff", "fontFamily": "'Comic Neue', cursive", "rotation": 0, "sfxClass": "", "rawBox": {"x1": 671, "x2": 717, "y1": 535, "y2": 781}, "boxX": 671, "boxY": 535, "boxW": 46, "boxH": 246, "textAlign": "center", "outlineWidth": 5, "outlineColor": "#030303", "hasShadow": false}, {"id": "1780782294493b4my860", "x": 401, "y": 533, "w": 116, "h": 31, "text": "Marketing", "japanese": "マーケティング", "fontSize": 18, "fontColor": "#ffffff", "fontFamily": "'Comic Neue', cursive", "rotation": 0, "sfxClass": "", "rawBox": {"x1": 401, "x2": 517, "y1": 533, "y2": 564}, "boxX": 401, "boxY": 533, "boxW": 116, "boxH": 31, "textAlign": "center", "outlineWidth": 5, "outlineColor": "#030303", "hasShadow": false}, {"id": "1780782294493fvyzn6b", "x": 147, "y": 531, "w": 71, "h": 30, "text": "Media", "japanese": "メディア", "fontSize": 18, "fontColor": "#ffffff", "fontFamily": "'Comic Neue', cursive", "rotation": 0, "sfxClass": "", "rawBox": {"x1": 147, "x2": 218, "y1": 531, "y2": 561}, "boxX": 147, "boxY": 531, "boxW": 71, "boxH": 30, "textAlign": "center", "outlineWidth": 5, "outlineColor": "#030303", "hasShadow": false}, {"id": "1780782294493ymw5mm9", "x": 629, "y": 485, "w": 35, "h": 24, "text": "...", "japanese": "．．．", "fontSize": 18, "fontColor": "#ffffff", "fontFamily": "'Comic Neue', cursive", "rotation": 0, "sfxClass": "", "rawBox": {"x1": 629, "x2": 664, "y1": 485, "y2": 509}, "boxX": 629, "boxY": 485, "boxW": 35, "boxH": 24, "textAlign": "center", "outlineWidth": 5, "outlineColor": "#030303", "hasShadow": false}, {"id": "17807822944931b83huc", "x": 1187, "y": 472, "w": 77, "h": 312, "text": "Nếu xong trước khi Kamiya-san đến công ty thì không vấn đề gì~", "japanese": "神谷さんが出社するまでに終われば問題なー", "fontSize": 18, "fontColor": "#ffffff", "fontFamily": "'Comic Neue', cursive", "rotation": 0, "sfxClass": "", "rawBox": {"x1": 1187, "x2": 1264, "y1": 472, "y2": 784}, "boxX": 1187, "boxY": 472, "boxW": 77, "boxH": 312, "textAlign": "center", "outlineWidth": 5, "outlineColor": "#030303", "hasShadow": false}, {"id": "17807822944934i9jzlj", "x": 288, "y": 446, "w": 64, "h": 42, "text": "Kinh doanh", "japanese": "営業", "fontSize": 17, "fontColor": "#ffffff", "fontFamily": "'Comic Neue', cursive", "rotation": 0, "sfxClass": "", "rawBox": {"x1": 288, "x2": 352, "y1": 446, "y2": 488}, "boxX": 288, "boxY": 446, "boxW": 64, "boxH": 42, "textAlign": "center", "outlineWidth": 5, "outlineColor": "#030303", "hasShadow": false}, {"id": "1780782294493fmuq0pf", "x": 33, "y": 419, "w": 84, "h": 221, "text": "Chỉ riêng một cái thiết kế thôi cũng cần kiểm tra nội bộ nhiều lần——", "japanese": "デザイン１つとっても何度もの社内チェックが必要となる――", "fontSize": 18, "fontColor": "#ffffff", "fontFamily": "'Comic Neue', cursive", "rotation": 0, "sfxClass": "", "rawBox": {"x1": 33, "x2": 117, "y1": 419, "y2": 640}, "boxX": 33, "boxY": 419, "boxW": 84, "boxH": 221, "textAlign": "center", "outlineWidth": 5, "outlineColor": "#030303", "hasShadow": false}, {"id": "1780782294493ftiqt6c", "x": 517, "y": 418, "w": 106, "h": 203, "text": "Huống hồ là một buổi thuyết trình 300 triệu, nhiều nhân sự từ các phòng ban được điều động", "japanese": "ましてや３億のプレゼンともなると様々な部屋から多くの人員が回され", "fontSize": 17, "fontColor": "#ffffff", "fontFamily": "'Comic Neue', cursive", "rotation": 0, "sfxClass": "", "rawBox": {"x1": 517, "x2": 623, "y1": 418, "y2": 621}, "boxX": 517, "boxY": 418, "boxW": 106, "boxH": 203, "textAlign": "center", "outlineWidth": 5, "outlineColor": "#030303", "hasShadow": false}, {"id": "1780782294493dyoe1uo", "x": 1151, "y": 328, "w": 102, "h": 91, "text": "Osh!! Còn 4 chỗ nữa thôi!", "japanese": "おし！！あと４か所", "fontSize": 18, "fontColor": "#ffffff", "fontFamily": "'Comic Neue', cursive", "rotation": 0, "sfxClass": "", "rawBox": {"x1": 1151, "x2": 1253, "y1": 328, "y2": 419}, "boxX": 1151, "boxY": 328, "boxW": 102, "boxH": 91, "textAlign": "center", "outlineWidth": 5, "outlineColor": "#030303", "hasShadow": false}, {"id": "1780782294493npcn0sk", "x": 664, "y": 318, "w": 104, "h": 139, "text": "Còn 12 phút!! Đang gấp lắm!! Cố lên!!", "japanese": "残り１２分！！まいてる！！いけるぞ！！", "fontSize": 18, "fontColor": "#ffffff", "fontFamily": "'Comic Neue', cursive", "rotation": 0, "sfxClass": "", "rawBox": {"x1": 664, "x2": 768, "y1": 318, "y2": 457}, "boxX": 664, "boxY": 318, "boxW": 104, "boxH": 139, "outlineColor": "#030303", "textAlign": "center", "outlineWidth": 5, "hasShadow": false}, {"id": "1780782294493d3lu8pg", "x": 738, "y": 47, "w": 82, "h": 165, "text": "Theo kịp tốc độ của tao!! Đừng có rớt lại đấy!!!", "japanese": "オレのスピードについてこい！！落ちるなよー！！！", "fontSize": 18, "fontColor": "#ffffff", "fontFamily": "'Comic Neue', cursive", "rotation": 0, "sfxClass": "", "rawBox": {"x1": 738, "x2": 820, "y1": 47, "y2": 212}, "boxX": 738, "boxY": 47, "boxW": 82, "boxH": 165, "textAlign": "center", "outlineWidth": 5, "outlineColor": "#030303", "hasShadow": false}, {"id": "1780782294493aqqodnh", "x": 1190, "y": 31, "w": 73, "h": 159, "text": "Mac chậm quá đấy Acc!!", "japanese": "マック遅いぞアック！！", "fontSize": 18, "fontColor": "#ffffff", "fontFamily": "'Comic Neue', cursive", "rotation": 0, "sfxClass": "", "rawBox": {"x1": 1190, "x2": 1263, "y1": 31, "y2": 190}, "boxX": 1190, "boxY": 31, "boxW": 73, "boxH": 159, "textAlign": "center", "outlineWidth": 5, "outlineColor": "#030303", "hasShadow": false}, {"id": "1780782294493pzf1uhv", "x": 557, "y": 30, "w": 48, "h": 138, "text": "Công ty quảng cáo", "japanese": "広告代理店", "fontSize": 18, "fontColor": "#ffffff", "fontFamily": "'Comic Neue', cursive", "rotation": 0, "sfxClass": "", "rawBox": {"x1": 557, "x2": 605, "y1": 30, "y2": 168}, "boxX": 557, "boxY": 30, "boxW": 48, "boxH": 138, "textAlign": "center", "outlineWidth": 5, "outlineColor": "#030303", "hasShadow": false}, {"id": "1780782294493jyv8d29", "x": 17, "y": 25, "w": 110, "h": 266, "text": "Bọn mình - những nhà thiết kế - nằm ở vị trí cuối cùng của tổ chức đó đấy", "japanese": "オレ達テサイナーはその組織の未端に位置しているわよ", "fontSize": 18, "fontColor": "#ffffff", "fontFamily": "'Comic Neue', cursive", "rotation": 0, "sfxClass": "", "rawBox": {"x1": 17, "x2": 127, "y1": 25, "y2": 291}, "boxX": 17, "boxY": 25, "boxW": 110, "boxH": 266, "textAlign": "center", "outlineWidth": 5, "outlineColor": "#030303", "hasShadow": false}]}